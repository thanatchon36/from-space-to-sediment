\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/11/09 Preprint style in the common arXiv layout]
\RequirePackage[letterpaper,textwidth=6.5in,textheight=9in,top=1in,headheight=13pt,headsep=16pt,footskip=28pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\newcommand{\headeright}{A Preprint}
\newcommand{\undertitle}{A Preprint}
\newcommand{\shorttitle}{}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\small\thepage}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\scshape\shorttitle}
\fancyhead[R]{\small\scshape\headeright}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.7em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.7em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\itshape}{\thesubsubsection}{0.7em}{}
\titlespacing*{\section}{0pt}{2.2ex plus 0.8ex minus 0.3ex}{1.0ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus 0.6ex minus 0.2ex}{0.7ex}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus 0.4ex minus 0.2ex}{0.5ex}
\renewcommand{\@maketitle}{%
  \newpage\null\vskip -0.25in%
  \begin{center}%
    \rule{\textwidth}{2.5pt}\par\vskip 0.2in%
    {\LARGE\bfseries\@title\par}%
    \vskip 0.18in\rule{\textwidth}{0.8pt}\par\vskip 0.12in%
    {\normalsize\scshape\undertitle\par}\vskip 0.14in%
    {\large\@author\par}\vskip 0.06in%
    {\normalsize\@date\par}%
  \end{center}\par\vskip 0.15in}
\renewenvironment{abstract}%
  {\begin{center}\large\bfseries Abstract\end{center}\vspace{-1.2ex}\begin{quote}\small}%
  {\end{quote}}
\newcommand{\keywords}[1]{\begin{quote}\small\textbf{\textit{Keywords}}\enspace #1\end{quote}}
\endinput
